# Backend environment variables — copy to .env and fill in real keys
# Never commit .env to git

# JWT secret for auth tokens
JWT_SECRET=change_me_to_a_random_secret_string

# --- LLM API Keys ---
# Gemini (https://aistudio.google.com/app/apikey)
VITE_GEMINI_API_KEY=your_gemini_key_here

# OpenAI (https://platform.openai.com/api-keys)
VITE_OPENAI_API_KEY=your_openai_key_here

# DeepSeek (https://platform.deepseek.com)
VITE_DEEPSEEK_API_KEY=your_deepseek_key_here

# Model names (defaults used if not set)
VITE_OPENAI_MODEL=gpt-4o-mini
VITE_DEEPSEEK_MODEL=deepseek-chat

# Finetuned model server — set to Modal URL after deploying modal_server.py
# Leave as localhost for local testing with server.py
FINETUNED_API_URL=http://localhost:8001/ask
FINETUNED_TIMEOUT_MS=30000
